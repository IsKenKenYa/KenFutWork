# ══════════════════════════════════════════════════════════════════════
# KenFutWork 配置模板（复制为 .env.local；云端部署复制为 .env.cloud 注入平台环境变量）
#
# 服务端用 `--env-file` 读 .env.local；web（Next）在 next.config 里也会读同一个文件，
# 因此「请求 baseUrl」这类前后端共用的值只需配一处。
#
# 命名：一律 `KENFUTWORK_*`。旧前缀 `LOOMIC_*` 仍被兼容读取（新名优先），
# 但新配置请用新名；改名前写入的凭证密文由 secret-store 的旧盐兜底继续可解。
# ══════════════════════════════════════════════════════════════════════

# ── 1. 部署形态与权限（决定能开哪些能力） ─────────────────────────────
# local（默认，桌面/本机）| self-hosted（自托管实例）| cloud（多租户云端）
#   · cloud 的差别：**默认禁止第三方插件**（共享基础设施不跑租户装的代码），
#     要开必须显式 KENFUTWORK_ALLOW_THIRD_PARTY_PLUGINS=true；
#   · 形态值写错会启动期报错（静默回落会改变安全口径）。
KENFUTWORK_DEPLOYMENT=local
# KENFUTWORK_ALLOW_THIRD_PARTY_PLUGINS=true

# ── 2. 监听与请求地址 ────────────────────────────────────────────────
KENFUTWORK_SERVER_PORT=3001
KENFUTWORK_WEB_ORIGIN=http://localhost:3000
# 浏览器请求后端用的 baseUrl（前端唯一需要配的地址）；留空则同源走 dev 代理。
# 云端填公网地址，如 https://api.example.com
NEXT_PUBLIC_SERVER_BASE_URL=http://localhost:3001

# ── 3. 数据库（自管 Postgres；唯一迁移源见 supabase/migrations） ─────
# 本机开发容器：docker-compose.pg.yml → 127.0.0.1:5433
# 自托管/云端：指向你的 Postgres；也接受通用 DATABASE_URL。
KENFUTWORK_DATABASE_URL=postgresql://kenfutwork:kenfutwork@127.0.0.1:5433/kenfutwork
# 桌面形态可捆绑本机 PG（exe 内嵌）：置 1 由进程自起。
# KENFUTWORK_EMBEDDED_PG=1
# KENFUTWORK_EMBEDDED_PG_PORT=5433
# 内嵌 PG 二进制目录（initdb/pg_ctl 所在；缺省按发布包/依赖包解析，
# 本机 brew 安装时可指 /opt/homebrew/opt/postgresql@17/bin）。
# KENFUTWORK_PG_BIN_DIR=

# ── 4. 认证与口令 ───────────────────────────────────────────────────
# 自管账号体系（默认）；local-trust 仅桌面单机形态使用。
# KENFUTWORK_AUTH_DRIVER=self-managed
#
# 测试账号口令（`pnpm seed` 用；缺省 kenfutwork——云端务必覆盖）。
# KENFUTWORK_TEST_ACCOUNT_PASSWORD=
#
# 管理员账号：给了口令才会创建/提升为平台管理员（幂等，可重复执行）。
# KENFUTWORK_ADMIN_EMAIL=admin@kenfutwork.local
# KENFUTWORK_ADMIN_PASSWORD=

# BYOK 凭证加密主密钥：**必填**。用户供应商实例的 API Key 用它加密落库
# （AES-256-GCM；服务端只写不读，日志脱敏）。丢失/更换会让既有密文解不开。
KENFUTWORK_CREDENTIAL_SECRET=

# ── 5. 存储与数据目录 ───────────────────────────────────────────────
# KENFUTWORK_DATA_DIR=./data
# KENFUTWORK_BLOB_DIR=./data/blobs
# KENFUTWORK_BLOB_PUBLIC_BASE_URL=http://127.0.0.1:3001/api/blobs

# ── 6. 沙箱与工作目录 ───────────────────────────────────────────────
# 沙箱根（缺省 <项目根|exe 安装目录>/tmp/sandbox）；每个画布一个持久工作目录
# `<sandboxRoot>/<画布UUID>`；相对路径按入口目录解析。
# KENFUTWORK_SANDBOX_ROOT=tmp/sandbox
# 检查点影子仓库根（缺省 <项目根|exe 安装目录>/data/checkpoints）；每个画布一个
# 裸仓库 `<checkpointRoot>/<画布UUID>.git`（GIT_DIR），work-tree 指向沙箱工作目录，
# 不碰项目自己的 .git；相对路径按入口目录解析。
# KENFUTWORK_CHECKPOINT_ROOT=data/checkpoints
# agent 文件后端的根目录（filesystem 后端形态用；state 后端不读）。
# KENFUTWORK_AGENT_FILES_ROOT=
# 工作目录 → 真实电脑环境映射（JSON：画布UUID → 本机绝对路径）；
# 命中映射的画布直接读写真实目录（不再落沙箱），用于「工作目录=项目」。
# KENFUTWORK_CANVAS_WORK_DIRS={"<canvasId>":"D:/Desktop/test"}

# ── 7. 技能 / 插件 / MCP ────────────────────────────────────────────
# 技能根目录（相对 apps/server 的 cwd，或绝对路径）。
# KENFUTWORK_SKILLS_ROOT=../../skills
# 插件落盘目录（缺省 <cwd>/.kenfutwork/plugins）。
# KENFUTWORK_PLUGINS_DIR=
# MCP server（JSON 数组，stdio 命令型）；界面上也能增删（需管理员）。
# KENFUTWORK_MCP_SERVERS=[{"name":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]
# 集成测试门控（KENFUTWORK_MCP_LIFECYCLE=1 启用 MCP 生命周期测试；生产无读者）。
# KENFUTWORK_MCP_LIFECYCLE=1

# ── 8. 模型与供应商 ─────────────────────────────────────────────────
# 默认模型（<实例ID>:<模型ID>）。**BYOK 实例在界面「供应商」里配，不在这里**——
# 这里的值只是「工作区还没设过默认模型」时的兜底。
# 例（智谱清言 GLM-5.3-Flash）：界面「供应商」加一个 OpenAI 兼容实例，
#   Base URL 填网关地址（智谱官方 https://open.bigmodel.cn/api/paas/v4，或用你手上的中转），
#   模型填 glm-5.3-flash；然后在这里写 <实例ID>:glm-5.3-flash
KENFUTWORK_AGENT_MODEL=
# 内置 provider 的 Key（BYOK 实例优先；没有实例时用这些）：
OPENAI_API_KEY=
OPENAI_API_BASE=
GOOGLE_API_KEY=
REPLICATE_API_TOKEN=
METASO_API_KEY=
# 可选：Google Vertex（与 Developer API 可共存，注册为独立 provider）
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/vertex-ai-sa.json
# GOOGLE_VERTEX_PROJECT=
# GOOGLE_VERTEX_LOCATION=

# ── 9. 联网搜索（web_search 工具） ──────────────────────────────────
# 这一段可以整块不配：不配 Key 时 web_search 走**网页通道**（静态抓一次搜索引擎结果页，
# 从链接还原结果列表），别的功能不受影响；抓取复用与 browser_open 同一个只读快照
# （同时限 / 同大小上限 / 同云元数据拦截），因此**不需要**打开「允许 AI 控制浏览器」。
# ⚠️ 如实说：网页通道**真机实测抓不到结果**——Bing 的结果链接不落在静态 HTML 的锚点里
#    （正文有结果文字、没有外部链接），百度直接回空白页。0 条时工具会说明原因并给替代路。
#    要稳定的联网检索，配下面的 Key（结构化 API），或打开「允许 AI 控制浏览器」后用
#    browser_navigate（受控浏览器拿到的是脚本渲染后的真实页面）。
# KENFUTWORK_SEARCH_API_KEY=
# KENFUTWORK_SEARCH_PROVIDER=metaso
# 网页通道用哪个引擎：bing（默认）| baidu。
# KENFUTWORK_SEARCH_ENGINE=bing
# 覆盖搜索端点（镜像/代理/联调）。没有秘塔 Key 时可用本机替身：
#   node scripts/本地搜索代理.mjs   →  KEY 填任意非空、ENDPOINT 指向 http://127.0.0.1:9099/search
# KENFUTWORK_SEARCH_ENDPOINT=

# ── 10. Agent 运行时 ────────────────────────────────────────────────
# 后端模式：state（默认，Postgres 检查点）| filesystem
KENFUTWORK_AGENT_BACKEND_MODE=state
# 上游停滞多久算有界失败（毫秒，缺省 180000）。
# KENFUTWORK_AGENT_STREAM_IDLE_TIMEOUT_MS=180000
# 上下文自动压缩的阈值覆盖（token 整数；缺省按「窗口 − 预留输出」算）。
# 用途：窗口认不出的模型自己定阈值；真机验证压缩机制时可压到很小（如 2000）。
# KENFUTWORK_AUTO_COMPACT_TRIGGER_TOKENS=2000
# 队列驱动（缺省 pgmq；本机无 pgmq 扩展时仅影响后台任务，agent run 不受影响）。
# KENFUTWORK_QUEUE_DRIVER=pgmq
# worker 轮询与批量（自托管调优；桌面 in-process 队列不读）。
# WORKER_POLL_INTERVAL_MS=2000
# WORKER_MAX_BATCH_SIZE=5
# 视频任务绝对超时（毫秒，缺省 1800000=30 分钟）：厂商假死强制 failed，防堵并发位。
# VIDEO_JOB_TIMEOUT_MS=1800000
# 异步视频轮询的延迟消息间隔（秒，缺省 10）。
# VIDEO_POLL_DELAY_SECONDS=10

# ── 11. 随包运行时与打包（桌面 exe 用） ──────────────────────────────
# 这些目录存在时注入沙箱 PATH（宿主机没装也能跑）：
# KENFUTWORK_NODE_BIN_DIR= / KENFUTWORK_PYTHON_BIN_DIR= / KENFUTWORK_JAVA_BIN_DIR=
# KENFUTWORK_GIT_BIN_DIR=（git 相反：优先本机自带，随包只兜底）
# KENFUTWORK_MIGRATIONS_ROOT= / KENFUTWORK_PGMQ_SHIM_DIR=

# ── 12. 本机代理与调试（可选） ──────────────────────────────────────
# GLOBAL_AGENT_HTTP_PROXY=http://127.0.0.1:7890
# KENFUTWORK_DUMP_CONFIG=1   # 启动期打印生效配置（排查用）

# ── 13. 桌面壳（Tauri）开发态 ────────────────────────────────────────
# 壳 spawn 服务端的命令/参数/工作目录（dev.sh 会注入 CWD=仓库根；一般不用手配）。
# KENFUTWORK_DESKTOP_SERVER_CMD=pnpm
# KENFUTWORK_DESKTOP_SERVER_ARGS=--filter @kenfutwork/server dev:server
# KENFUTWORK_DESKTOP_SERVER_CWD=

# ── 14. agent 治理（DEC-17/18；可选。优先级 = 设置页(库) ?? env ?? 内置默认） ──
# 子代理派生深度上限（1=禁孙代理）；后台任务并发上限
# KENFUTWORK_SUBAGENT_MAX_DEPTH=1
# KENFUTWORK_SUBAGENT_MAX_CONCURRENCY=4
# LLM 请求级重试上限（含首次，0=不重试）；无限重试开关（true/1/yes/on，治持续 429）
# KENFUTWORK_LLM_REQUEST_MAX_RETRIES=10
# KENFUTWORK_LLM_INFINITE_RETRY=false
# Code 模式 execute 命令超时（毫秒）
# KENFUTWORK_EXECUTE_TIMEOUT_MS=120000
# 后台任务续轮上限（防挂死任务无限等待）
# KENFUTWORK_SUBAGENT_MAX_CONTINUATIONS=50
# Computer Use 插件：单动作超时毫秒 / 观察树文本预算字节 / 截图内联预算字节 / 单 run 动作上限 / 租约会话时长毫秒
# KENFUTWORK_COMPUTER_USE_ACTION_TIMEOUT_MS=10000
# KENFUTWORK_COMPUTER_USE_OBSERVE_MAX_BYTES=32768
# KENFUTWORK_COMPUTER_USE_SCREENSHOT_MAX_BYTES=262144
# KENFUTWORK_COMPUTER_USE_MAX_ACTIONS_PER_RUN=200
# KENFUTWORK_COMPUTER_USE_SESSION_MAX_MS=1800000
