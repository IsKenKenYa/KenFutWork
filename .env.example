# ══════════════════════════════════════════════════════════════════════
# KenFutWork Environment Variables
# ══════════════════════════════════════════════════════════════════════
# Copy to .env.local (local dev) or .env.cloud (cloud deploy).
# Values marked [required] must be set; others have sensible defaults.

# ── Server ─────────────────────────────────────────────────────────
KENFUTWORK_SERVER_PORT=3001
KENFUTWORK_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SERVER_BASE_URL=http://localhost:3001        # cloud: https://your-api.up.railway.app

# ── Supabase (required) ───────────────────────────────────────────
# 自管 Postgres 连接串（首选；纯 PG 容器见 docker-compose.pg.yml）。
# 也接受通用的 DATABASE_URL。
KENFUTWORK_DATABASE_URL='postgresql://kenfutwork:kenfutwork@127.0.0.1:5433/kenfutwork'


# Supabase browser-safe (NEXT_PUBLIC_ prefix exposes to frontend)

# ── Agent LLM ─────────────────────────────────────────────────────
KENFUTWORK_AGENT_BACKEND_MODE=state                          # "state" (default) or "filesystem"
KENFUTWORK_AGENT_MODEL=google:gemini-3-flash-preview         # format: <provider>:<model-id>
# Provider "openai" → needs OPENAI_API_KEY (+ optional OPENAI_API_BASE for proxy)
# Provider "google" → needs GOOGLE_API_KEY
OPENAI_API_KEY=                                          # optional, for openai provider
OPENAI_API_BASE=                                         # optional, custom endpoint / proxy
GOOGLE_API_KEY=                                          # optional, for google provider + Veo video + Imagen image

# ── Image / Video Generation ─────────────────────────────────────
REPLICATE_API_TOKEN=                                     # optional, enables 13 Replicate video/image models
METASO_API_KEY=                                          # optional, enables MiniMax H3 video via Metaso
METASO_API_BASE=https://metaso.cn/api/minimax/           # optional, Metaso H3 V2 base URL override
# GOOGLE_API_KEY above also enables Google Veo 3.1 video + Imagen image (Developer API)

# ── Google Vertex AI (optional, coexists with Developer API) ────
# Uses GCP service account for auth. Both Developer API and Vertex AI
# can be configured simultaneously — they register as separate providers.
GOOGLE_APPLICATION_CREDENTIALS=                          # path to service account JSON (e.g., ./credentials/vertex-ai-sa.json)
GOOGLE_VERTEX_PROJECT=                                   # GCP project ID (e.g., my-project-123456)
GOOGLE_VERTEX_LOCATION=                                  # GCP region (e.g., us-central1)

# ── Skills & Sandbox ─────────────────────────────────────────────
# Local dev: relative from apps/server/ cwd → ../../skills
# Docker/Railway: /opt/kenfutwork/skills (Dockerfile copies skills/ there)
KENFUTWORK_SKILLS_ROOT=../../skills

# 沙箱根目录（可选；缺省 <项目根或 exe 安装目录>/tmp/sandbox）。
# 每个画布一个持久工作目录 = <sandboxRoot>/<画布UUID>；相对路径按入口目录解析。
# KENFUTWORK_SANDBOX_ROOT=tmp/sandbox

# 工作目录 → 真实电脑环境映射（可选，JSON：画布UUID → 本机绝对路径）。
# 命中映射的画布直接读写真实目录（不再落沙箱）；未命中照旧落 <sandboxRoot>/<画布UUID>。
# KENFUTWORK_CANVAS_WORK_DIRS={"<canvasId>":"D:/Desktop/test"}

# ── Worker (optional, defaults shown) ────────────────────────────
# WORKER_CODE_CONCURRENCY=3
# WORKER_IMAGE_CONCURRENCY=3
# WORKER_VIDEO_CONCURRENCY=2
# WORKER_POLL_INTERVAL_MS=2000

# ── Misc ─────────────────────────────────────────────────────────
GOOGLE_FONTS_API_KEY=                                    # optional, brand kit font picker
# VOLCES_API_KEY=                                        # optional, TTS
# VOLCES_BASE_URL=                                       # optional, TTS

# ── Local dev only ───────────────────────────────────────────────
# GLOBAL_AGENT_HTTP_PROXY=http://127.0.0.1:7890          # HTTP proxy for outbound requests

# BYOK 凭证加密主密钥（SecretStore，DEC-7）。配置后用户供应商实例的 API Key 才可写入（服务端 AES-256-GCM 加密落库，只写不读）。
KENFUTWORK_CREDENTIAL_SECRET=

# blob 缝（M3.1）：对象存储形态。
# KENFUTWORK_BLOB_DIR=
# KENFUTWORK_BLOB_PUBLIC_BASE_URL=http://127.0.0.1:3001/api/blobs

# MCP server 配置（P4d，JSON 数组，v1 支持 stdio 命令型）：
# KENFUTWORK_MCP_SERVERS=[{"name":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-fs","/tmp"]}]

# 联网搜索（§4.5 web_search 工具，BYOK 搜索供应商）。配置 Key 即启用；供应商 v1 仅 metaso。
# 注意：秘塔按量付费、**无免费额度**（无 Key/空 Bearer/任意字符串 Key 一律 errCode 2005），
# 所以未配置 Key 时该插件按 enabled 判定不装配（web_search 不注册）属预期，不是故障。
# KENFUTWORK_SEARCH_API_KEY=
# KENFUTWORK_SEARCH_PROVIDER=metaso
# 覆盖搜索端点（镜像/代理/联调）；留空走秘塔官方 https://metaso.cn/api/v1/search。
# 没有秘塔 Key 时想用联网搜索：先跑 node scripts/本地搜索代理.mjs（结果来自真实必应），
# 再把 KEY 填任意非空字符串、ENDPOINT 指向它。
# KENFUTWORK_SEARCH_ENDPOINT=
# 验收真实检索（忽略上面的 ENDPOINT 覆盖，直打真实端点）：node scripts/诊断联网搜索.mjs

# 模型流空闲看门狗（毫秒）：上游停滞超过该时长即按有界失败终止本轮（缺省 180000）。
# 背景：one-api 代理 + glm 偶发「首 token 后停滞」，消费侧曾无限挂起且取消不生效。
# KENFUTWORK_AGENT_STREAM_IDLE_TIMEOUT_MS=180000
