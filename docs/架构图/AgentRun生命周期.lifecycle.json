  "cards": [
    {
      "dot": "emerald",
      "title": "主链路",
      "items": [
        "accepted → running → completed 四段主轨，状态即落 agent_runs",
        "billing.error 会中止 run 并补写 run.failed，防止悬挂",
        "终态整条保留消息（content_blocks 口径），刷新后从 HTTP 读回"
      ]
    },
    {
      "dot": "rose",
      "title": "恢复回路",
      "items": [
        "可重试失败广播 run.retrying，以新 runId 重新 ack",
        "重试预算缺省 10；工具已执行即不重试，防重复副作用",
        "空轮次判失败并给可读原因，不静默重放"
      ]
    },
    {
      "dot": "slate",
      "title": "终态出口",
      "items": [
        "agent.cancel 用户中止，收尾补终态",
        "不重试的 failed 即终态，error_message 落库",
        "canceled / failed / completed 互斥，无复活路径"
      ]
    }
  ]
