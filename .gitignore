# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnpm-store
/.trash-node_modules-root
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
**/.next/
/out/
apps/web/out/
supabase/.temp/

# production
/build
**/dist
**/.turbo

# misc
.DS_Store
*.pem
.worktrees/
.superpowers/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# agent 沙箱默认根（<项目根>/tmp/sandbox/<画布UUID>，运行时数据不入库）
/tmp/

# local env files
.env*.local
.env
.env.cloud

# service account credentials (never commit)
**/credentials/*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
logs/
supabase/supabase/

tmp/
temp/.claude/worktrees/

# internal dev docs & operational secrets (keep locally, exclude from repo)
.claude/skills/production-debugger/
docs/superpowers/
docs/CODE_QUALITY_AUDIT_REPORT.md
docs/DEPLOY_CHECKLIST.md
docs/home-discovery-library.md
docs/lovart-deep-analysis-*.md
docs/tech/pricing-profitability-report.md
docs/tech/replicate-models-pricing.md

# 本地打包产物（package-win / web 静态导出）
release/
apps/web/out/
apps/web/tmp/

# 本地 blob 目录（M3.1 local 形态）：本机数据，不入库
/data/

# 已安装插件（机器本地，含第三方代码，禁止提交）
.kenfutwork/

# 本机临时目录（如 .tmp-mcp：E2E 测试用 MCP server 夹具，由 .env.local 的 LOOMIC_MCP_SERVERS 挂载）
.tmp-*/

# 随包分发的语言运行时（Node/Python/JDK，scripts/fetch-runtimes.mjs 拉取）
/runtime/
.kenfutwork-data/

# logo 字标字体样张（非商免/第三方字体，仅本机预览，禁止入库）
docs/design/logo/字体/

# 本机草稿/一次性验证脚本（真机走查用；不进 CI、不入库）
.scratch/

# Rust / Tauri 构建产物（桌面壳）
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# 安装包产物（默认落在仓库根，见 apps/desktop/scripts/collect-bundle.mjs）
/KenFutWork_*-setup.exe
