{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.js",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.ts",
      "**/*.tsx",
      "**/*.json",
      "**/*.jsonc",
      "!**/node_modules",
      "!**/.turbo",
      "!**/.next",
      "!**/dist",
      "!**/out",
      "!apps/server/src/features/model-providers/models-dev.snapshot.ts",
      "!**/.pnpm-store",
      "!**/tmp",
      "!**/.zcode",
      "!**/target",
      "!**/gen",
      "!**/references",
      "!**/.kenfutwork",
      "!**/.scratch",
      "!**/release",
      "!**/target",
      "!**/gen",
      "!**/data",
      "!**/logs",
      "!**/runtime",
      "!**/flow",
      "!**/docs/api/openapi.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noTsIgnore": "warn",
        "noArrayIndexKey": "warn"
      },
      "performance": {
        "noImgElement": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn"
      },
      "a11y": {
        "noSvgWithoutTitle": "warn",
        "noStaticElementInteractions": "warn",
        "useKeyWithClickEvents": "warn",
        "useSemanticElements": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/src/components/workbench/zcode/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useAriaPropsSupportedByRole": "warn",
            "useValidAriaRole": "warn",
            "noLabelWithoutControl": "warn",
            "useMediaCaption": "warn"
          },
          "correctness": {
            "useExhaustiveDependencies": "warn"
          },
          "suspicious": {
            "noControlCharactersInRegex": "warn"
          },
          "security": {
            "noDangerouslySetInnerHtml": "warn"
          },
          "performance": {
            "noImgElement": "warn"
          },
          "style": {
            "noNonNullAssertion": "warn"
          }
        }
      }
    }
  ]
}
