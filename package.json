{
  "name": "kenfutwork",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "turbo run dev",
    "desktop": "bash apps/desktop/dev.sh",
    "package:win": "node scripts/package-win.mjs",
    "build": "turbo run build",
    "lint": "biome check .",
    "test:docs": "node scripts/check-docs.mjs",
    "test:env": "node scripts/check-env.mjs",
    "test:workspace": "node --test tests/workspace.test.mjs",
    "test:packages": "turbo run test",
    "test": "pnpm run test:workspace && pnpm run test:packages",
    "seed": "pnpm --filter @kenfutwork/server seed:accounts",
    "typecheck": "turbo run typecheck",
    "smoke:desktop": "node scripts/desktop-offline-smoke.mjs",
    "verify:desktop": "node scripts/验收打包桌面端.mjs",
    "fetch:runtimes": "node scripts/fetch-runtimes.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "esbuild": "^0.28.2",
    "postject": "1.0.0-alpha.6",
    "turbo": "^2.10.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "global-agent": "^4.1.3"
  }
}
