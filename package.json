{
  "name": "kenfutwork",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "desktop": "bash apps/desktop/dev.sh",
    "package:win": "node scripts/package-win.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "build": "turbo run build",
    "lint": "node scripts/lint-biome.mjs",
    "test:docs": "node scripts/check-docs.mjs",
    "test:env": "node scripts/check-env.mjs",
    "test:actions": "node scripts/check-actions.mjs",
    "test:workspace": "node --test tests/workspace.test.mjs tests/api-spec-consistency.test.mjs tests/dependency-security.test.mjs tests/chat-regex-security.test.mjs",
    "api:spec": "pnpm --filter @kenfutwork/server api:spec",
    "test:packages": "turbo run test",
    "test": "pnpm run test:workspace && pnpm run test:packages",
    "typecheck": "turbo run typecheck",
    "smoke:desktop": "node scripts/desktop-offline-smoke.mjs",
    "verify:desktop": "node scripts/验收打包桌面端.mjs",
    "fetch:runtimes": "node scripts/fetch-runtimes.mjs"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.0",
    "@biomejs/biome": "^2.5.14",
    "appdmg": "^0.6.6",
    "esbuild": "^0.28.2",
    "node-gyp": "^13.0.2",
    "postject": "1.0.0-alpha.6",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "global-agent": "^4.1.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "langchain@1.5.11": "patches/langchain@1.5.11.patch",
      "@modelcontextprotocol/sdk@1.32.1": "patches/@modelcontextprotocol__sdk@1.32.1.patch",
      "@anthropic-ai/sandbox-runtime@0.0.78": "patches/@anthropic-ai__sandbox-runtime@0.0.78.patch",
      "file-type@16.5.4": "patches/file-type@16.5.4.patch",
      "image-size@0.7.5": "patches/image-size@0.7.5.patch",
      "node-forge@1.4.0": "patches/node-forge@1.4.0.patch"
    },
    "overrides": {
      "@modelcontextprotocol/sdk@<1.32.1": "1.32.1",
      "proxy-addr@<2.0.8": "2.0.8",
      "fast-uri@3": "3.1.8",
      "fast-uri@4": "4.1.5",
      "nanoid@3": "3.3.20",
      "nanoid@4": "5.1.16",
      "ip-address@<10.7.1": "10.7.1",
      "dompurify@<3.4.16": "3.4.16",
      "qs@6": "6.16.0",
      "source-map-js@<1.2.2": "1.2.2",
      "hono@<4.13.11": "4.13.11",
      "lodash-es@<4.18.0": "4.18.1",
      "follow-redirects@<1.16.1": "1.16.1",
      "linkify-it@<5.0.2": "5.0.2",
      "katex@<0.18.2": "0.18.2",
      "react@19": "19.3.1",
      "react-dom@19": "19.3.1",
      "@types/node@>16": "24.13.3",
      "postcss-selector-parser@6": "7.1.6"
    }
  }
}
