+/// 宿主上传的用户字体（Work 引擎页），web 构建从同源 `fonts/manifest.txt` 拉取并缓存。
+/// `None` 表示当前页面没有该清单（非 Work 宿主），调用方据此不显示入口。
+pub(crate) fn host_fonts(ctx: &egui::Context) -> Option<std::sync::Arc<Vec<(String, Vec<u8>)>>> {
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        let _ = ctx;
+        return None;
+    }
+    #[cfg(target_arch = "wasm32")]
+    {
+        use std::sync::{Arc, Mutex, OnceLock};
+        type Fetched = Arc<Mutex<Option<Arc<Vec<(String, Vec<u8>)>>>>>;
+        static CACHE: OnceLock<Fetched> = OnceLock::new();
+        let slot = CACHE.get_or_init(|| {
+            let slot: Fetched = Arc::new(Mutex::new(None));
+            let fill = slot.clone();
+            let ctx = ctx.clone();
+            wasm_bindgen_futures::spawn_local(async move {
+                let fonts = Arc::new(crate::host_font_fetch::fetch_host_fonts().await);
+                if let Ok(mut guard) = fill.lock() {
+                    *guard = Some(fonts);
+                }
+                ctx.request_repaint();
+            });
+            slot
+        });
+        slot.lock().ok().and_then(|g| g.clone())
+    }
+}
