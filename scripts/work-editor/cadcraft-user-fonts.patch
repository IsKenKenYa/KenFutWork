+/// Register a font file the page fetched (`fonts/user/…`) and return the family names it carries.
+/// The file is stored under each family name as well, so a text style that names the family
+/// (`霞鹜文楷 轻便版`) resolves without the caller knowing the stored stem.
+pub fn register_family_font(bytes: Vec<u8>) -> Vec<String> {
+    let data = Arc::new(bytes);
+    let mut families: Vec<String> = Vec::new();
+    for face in faces(&data) {
+        let Some(font) = face.font() else { continue };
+        for id in [skrifa::string::StringId::TYPOGRAPHIC_FAMILY_NAME, skrifa::string::StringId::FAMILY_NAME] {
+            if let Some(s) = font.localized_strings(id).english_or_first() {
+                let name = s.to_string();
+                if !name.is_empty() && !families.iter().any(|n| n.eq_ignore_ascii_case(&name)) {
+                    families.push(name);
+                }
+            }
+        }
+    }
+    let mut g = lock();
+    for family in &families {
+        g.files.insert(key(family), data.clone());
+    }
+    g.resolved.clear();
+    g.fallback = Fallback::default();
+    families
+}
+
+/// The family names of fonts registered by [`register`]/[`register_family_font`], for the font
+/// menus (web builds have no system fonts to list).
+pub fn registered_families() -> Vec<String> {
+    let g = lock();
+    let mut out: Vec<String> = g.files.keys().cloned().collect();
+    out.sort();
+    out.dedup();
+    out
+}
