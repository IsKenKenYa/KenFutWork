+#[test]
+fn chinese_result_counts_use_the_catalog_template() {
+    needs_catalogs!();
+    for (code, expected) in [("zh-hans", "0 个结果"), ("zh-hant", "0 個結果")] {
+        assert_eq!(fmt(tr(lang(code), "{n} results"), &[("n", "0")]), expected);
+    }
+    assert_eq!(fmt(tr(Lang::EN, "{n} results"), &[("n", "0")]), "0 results");
+}
