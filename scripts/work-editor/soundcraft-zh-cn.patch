@@ -0,0 +1,347 @@
+//! Simplified Chinese display labels. Command ids, menu paths and document values stay unchanged.
+
+pub(crate) fn tr(text: &str) -> &str {
+    match text {
+        // Menus.
+        "File" => "文件",
+        "Edit" => "编辑",
+        "View" => "视图",
+        "Track" => "音轨",
+        "Clip" => "片段",
+        "Event" => "事件",
+        "AudioSuite" => "音频处理",
+        "Options" => "选项",
+        "Setup" => "设置",
+        "Window" => "窗口",
+        "New..." | "New…" => "新建…",
+        "Open" => "打开",
+        "Open..." | "Open…" => "打开…",
+        "Open Recent" => "最近打开",
+        "No Recent Sessions" => "无最近会话",
+        "Clear Recent" => "清空最近记录",
+        "Session..." => "会话…",
+        "Open Session" => "打开会话",
+        "Close Session" => "关闭会话",
+        "Close Window" => "关闭窗口",
+        "Save Session" => "保存会话",
+        "Save Session As" | "Save Session As..." => "会话另存为",
+        "Save Session Copy In..." => "保存会话副本…",
+        "Save As Template..." => "另存为模板…",
+        "Revert Session to Saved..." => "还原到已存版本…",
+        "Bounce Mix..." => "并轨混音…",
+        "Import" => "导入",
+        "Export" => "导出",
+        "Import Audio" => "导入音频",
