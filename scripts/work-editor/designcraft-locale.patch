+/// 浏览器里的偏好键（与原生端文件名同名，便于对照）。
+const PREFS_KEY: &str = "designcraft.ui";
+
+fn read_prefs() -> Option<String> {
+    web_sys::window()?.local_storage().ok()??.get_item(PREFS_KEY).ok()?
+}
+
+fn write_prefs(json: &str) {
+    let Some(window) = web_sys::window() else { return };
+    let Ok(Some(storage)) = window.local_storage() else { return };
+    let _ = storage.set_item(PREFS_KEY, json);
+}
