{
  "name": "@loomic/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@fastify/websocket": "^11.3.0",
    "@google/genai": "^2.19.0",
    "@langchain/anthropic": "^1.5.10",
    "@langchain/core": "^1.2.9",
    "@langchain/google-genai": "^2.3.0",
    "@langchain/google-vertexai": "^2.3.0",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/openai": "^1.5.10",
    "@loomic/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "deepagents": "^1.13.2",
    "embedded-postgres": "17.10.0-beta.17",
    "fastify": "^5.12.1",
    "google-auth-library": "^11.0.2",
    "jose": "^6.2.10",
    "js-yaml": "^5.4.1",
    "langchain": "^1.5.10",
    "openai": "^7.8.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "tar": "^7.5.22",
    "undici": "^8.10.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@loomic/config": "workspace:*",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  },
  "scripts": {
    "build": "node ../../scripts/validate-foundation-app.mjs build",
    "predev": "pnpm --filter @loomic/shared build",
    "dev": "node --watch --env-file=../../.env.local --import tsx ./src/server.ts & WORKER_ID=w1 node --watch --env-file=../../.env.local --import tsx ./src/worker.ts & wait",
    "dev:server": "node --watch --env-file=../../.env.local --import tsx ./src/server.ts",
    "dev:worker": "node --watch --env-file=../../.env.local --import tsx ./src/worker.ts",
    "dev:workers:2": "WORKER_ID=w1 node --watch --env-file=../../.env.local --import tsx ./src/worker.ts & WORKER_ID=w2 node --watch --env-file=../../.env.local --import tsx ./src/worker.ts & wait",
    "dev:workers:3": "WORKER_ID=w1 node --watch --env-file=../../.env.local --import tsx ./src/worker.ts & WORKER_ID=w2 node --watch --env-file=../../.env.local --import tsx ./src/worker.ts & WORKER_ID=w3 node --watch --env-file=../../.env.local --import tsx ./src/worker.ts & wait",
    "worker": "node --env-file=../../.env.local --import tsx ./src/worker.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file=../../.env.local --import tsx ./src/server.ts",
    "migrate": "node --env-file=../../.env.local --import tsx ./src/migrate.ts",
    "auth:seed": "node --env-file=../../.env.local --import tsx ./src/seed-auth-credentials.ts"
  },
  "start:worker": "node --env-file=../../.env.local --import tsx ./src/worker.ts"
}
