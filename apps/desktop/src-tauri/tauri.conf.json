{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KenFutWork",
  "version": "0.1.0",
  "identifier": "com.kenfutwork.desktop",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../web/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KenFutWork 工作台",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "publisher": "KenFutWork",
    "copyright": "GPL-3.0",
    "category": "DeveloperTool",
    "shortDescription": "BYOK AI 工作台（画布创作 / 编码 agent）",
    "longDescription": "KenFutWork：自带数据库与运行时的本机 AI 工作台。装完即可用，无需另装 Node、Python、JDK 或数据库。",
    "resources": {
      "../../../release/KenFutWork-server.exe": "app/KenFutWork-server.exe",
      "../../../release/web": "app/web",
      "../../../release/pg": "app/pg",
      "../../../release/runtime": "app/runtime",
      "../../../release/node_modules": "app/node_modules",
      "../../../release/supabase": "app/supabase"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "KenFutWork"
      }
    }
  }
}
