{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KenFutWork",
  "version": "0.1.0",
  "identifier": "com.kenfutwork.desktop",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../web/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KenFutWork 工作台",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
