{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "默认窗口能力：核心事件与自定义命令。",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "allow-local-desktop",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-theme"
  ]
}
