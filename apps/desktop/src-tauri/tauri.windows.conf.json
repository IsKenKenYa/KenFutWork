{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "../../../release/KenFutWork-server.exe": "app/KenFutWork-server.exe",
      "../../../release/web": "app/web",
      "../../../release/pg": "app/pg",
      "../../../release/runtime": "app/runtime",
      "../../../release/process-helper": "app/process-helper",
      "../../../release/node_modules": "app/node_modules",
      "../../../release/supabase": "app/supabase",
      "../../../release/legal": "app/legal",
      "../../../release/dify": "app/dify",
      "../../../release/plugins": "app/plugins"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh",
        "startMenuFolder": "KenFutWork",
        "headerImage": "installer-header.bmp",
        "sidebarImage": "installer-sidebar.bmp"
      }
    }
