{
  "name": "@zcode/ui",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./index.ts"
    },
    "./useTheme": {
      "types": "./dist-types/useTheme.d.ts",
      "default": "./dist/useTheme.js"
    },
    "./conversation-share-readonly": {
      "types": "./dist-types/v4/ConversationShareReadonlyTimeline.d.ts",
      "default": "./dist/v4/ConversationShareReadonlyTimeline.js"
    },
    "./oauth-provider-icon": {
      "types": "./dist-types/lib/oauthProviderIcon.d.ts",
      "default": "./dist/lib/oauthProviderIcon.js"
    },
    "./message": {
      "types": "./dist-types/components/ai-elements/message.d.ts",
      "default": "./dist/components/ai-elements/message.js"
    },
    "./e2e-store-bridge": {
      "types": "./dist-types/lib/e2eStoreBridgeBootstrap.d.ts",
      "default": "./dist/lib/e2eStoreBridgeBootstrap.js"
    },
    "./remote-workspace-session-store": {
      "types": "./dist-types/store/remoteWorkspaceSessionStore.d.ts",
      "default": "./dist/store/remoteWorkspaceSessionStore.js"
    },
    "./styles.css": "./dist/code-ui.css",
    "./replay": {
      "types": "./dist-types/replay.d.ts",
      "default": "./dist/replay.js"
    },
    "./design-shared": {
      "types": "./dist-types/designShared.d.ts",
      "default": "./dist-design/designShared.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.vendor.json && tsc -p tsconfig.host.json && vite build && vite build --config vite.design.config.mjs && node ../../../../../../scripts/stage-code-ui.mjs",
    "typecheck": "tsc -p tsconfig.vendor.json && tsc -p tsconfig.host.json"
  },
