{
  "name": "kenfutwork-ha",
  "version": "1.0.0",
  "description": "智能家居插件（Home Assistant）：填入自建 HA 的地址与长期令牌，侧栏面板看与控制实体（灯/开关/窗帘/空调等），agent 也能直接操作；配置保存在实例私有存储，服务端重启后无需重填。",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "lib",
    "panel.html",
    "panel.js",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "GPL-3.0",
  "kenfutwork": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "title": "智能家居",
    "category": "工具与集成",
    "assets": true,
    "ui": [
      {
        "id": "ha",
        "title": "智能家居",
        "slot": "sidebar",
        "url": "assets/panel.html",
        "icon": "assets/icon.svg"
      }
    ]
  }
}
